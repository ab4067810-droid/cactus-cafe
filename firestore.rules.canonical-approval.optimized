rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return signedIn()
        && get(userPath).data.role == "admin";
    }

    function migrationPath() {
      return /databases/$(database)/documents/menuControl/migration;
    }

    function priceBookPath() {
      return /databases/$(database)/documents/menuControl/current;
    }

    function validText(value, maxLength) {
      return value is string
        && value.size() > 0
        && value.size() <= maxLength;
    }

    function validRequestItem(item) {
      return item is map
        && item.keys().size() == 2
        && item.keys().hasAll(["id", "quantity"])
        && item.id is string
        && item.id.size() > 0
        && item.id.size() <= 1500
        && !item.id.matches(".*[/].*")
        && item.quantity is int
        && item.quantity >= 1
        && item.quantity <= 99;
    }

    function validRequestItems(items) {
      let count = items.size();
      return items is list
        && count >= 1
        && count <= 10
        && validRequestItem(items[0])
        && (count <= 1 || validRequestItem(items[1]))
        && (count <= 2 || validRequestItem(items[2]))
        && (count <= 3 || validRequestItem(items[3]))
        && (count <= 4 || validRequestItem(items[4]))
        && (count <= 5 || validRequestItem(items[5]))
        && (count <= 6 || validRequestItem(items[6]))
        && (count <= 7 || validRequestItem(items[7]))
        && (count <= 8 || validRequestItem(items[8]))
        && (count <= 9 || validRequestItem(items[9]));
    }

    function requestItemsHaveDistinctIds(items) {
      let count = items.size();
      let ids = count == 0
        ? []
        : [items[0].id]
          .concat(count > 1 ? [items[1].id] : [])
          .concat(count > 2 ? [items[2].id] : [])
          .concat(count > 3 ? [items[3].id] : [])
          .concat(count > 4 ? [items[4].id] : [])
          .concat(count > 5 ? [items[5].id] : [])
          .concat(count > 6 ? [items[6].id] : [])
          .concat(count > 7 ? [items[7].id] : [])
          .concat(count > 8 ? [items[8].id] : [])
          .concat(count > 9 ? [items[9].id] : []);
      return count >= 1
        && count <= 10
        && ids.toSet().size() == count;
    }

    function validRequestData(data) {
      return data is map
        && data.keys().size() == 10
        && data.keys().hasAll([
          "customerId",
          "customerEmail",
          "customerName",
          "phone",
          "items",
          "orderType",
          "address",
          "notes",
          "status",
          "createdAt"
        ])
        && data.customerId is string
        && data.customerId.size() > 0
        && data.customerEmail is string
        && data.customerEmail.size() <= 254
        && validText(data.customerName, 120)
        && validText(data.phone, 40)
        && validRequestItems(data.items)
        && requestItemsHaveDistinctIds(data.items)
        && data.orderType in ["takeout", "delivery", "dine-in"]
        && data.address is string
        && data.address.size() <= 500
        && (data.orderType != "delivery" || data.address.size() > 0)
        && (data.orderType == "delivery" || data.address == "")
        && data.notes is string
        && data.notes.size() <= 1000
        && data.status == "pending"
        && data.createdAt is timestamp;
    }

    function validRequestCreate(data) {
      return validRequestData(data)
        && data.customerId == request.auth.uid
        && (data.customerEmail == ""
          || data.customerEmail == request.auth.token.email)
        && data.createdAt == request.time;
    }

    function migrationIsReady() {
      return get(migrationPath()).data.state == "ready";
    }

    function validPriceBook(data) {
      return data is map
        && data.revision is int
        && data.revision >= 1
        && data.prices is map;
    }

    function validApprovedItem(orderItem, requestedItem, prices) {
      let entry = prices.get(requestedItem.id, null);
      return requestedItem is map
        && requestedItem.id is string
        && requestedItem.quantity is int
        && requestedItem.quantity >= 1
        && requestedItem.quantity <= 99
        && entry is map
        && entry.name is string
        && entry.priceCents is int
        && entry.available == true
        && orderItem == {
          "id": requestedItem.id,
          "name": entry.name,
          "quantity": requestedItem.quantity,
          "priceCents": entry.priceCents
        };
    }

    function validApprovedItems(orderItems, requestedItems, prices) {
      let count = requestedItems.size();
      return orderItems is list
        && orderItems.size() == count
        && count >= 1
        && count <= 10
        && validApprovedItem(orderItems[0], requestedItems[0], prices)
        && (count <= 1
          || validApprovedItem(orderItems[1], requestedItems[1], prices))
        && (count <= 2
          || validApprovedItem(orderItems[2], requestedItems[2], prices))
        && (count <= 3
          || validApprovedItem(orderItems[3], requestedItems[3], prices))
        && (count <= 4
          || validApprovedItem(orderItems[4], requestedItems[4], prices))
        && (count <= 5
          || validApprovedItem(orderItems[5], requestedItems[5], prices))
        && (count <= 6
          || validApprovedItem(orderItems[6], requestedItems[6], prices))
        && (count <= 7
          || validApprovedItem(orderItems[7], requestedItems[7], prices))
        && (count <= 8
          || validApprovedItem(orderItems[8], requestedItems[8], prices))
        && (count <= 9
          || validApprovedItem(orderItems[9], requestedItems[9], prices));
    }

    function approvedItemsTotalCents(orderItems) {
      let count = orderItems.size();
      return orderItems[0].priceCents * orderItems[0].quantity
        + (count <= 1
          ? 0
          : orderItems[1].priceCents * orderItems[1].quantity)
        + (count <= 2
          ? 0
          : orderItems[2].priceCents * orderItems[2].quantity)
        + (count <= 3
          ? 0
          : orderItems[3].priceCents * orderItems[3].quantity)
        + (count <= 4
          ? 0
          : orderItems[4].priceCents * orderItems[4].quantity)
        + (count <= 5
          ? 0
          : orderItems[5].priceCents * orderItems[5].quantity)
        + (count <= 6
          ? 0
          : orderItems[6].priceCents * orderItems[6].quantity)
        + (count <= 7
          ? 0
          : orderItems[7].priceCents * orderItems[7].quantity)
        + (count <= 8
          ? 0
          : orderItems[8].priceCents * orderItems[8].quantity)
        + (count <= 9
          ? 0
          : orderItems[9].priceCents * orderItems[9].quantity);
    }

    function validApprovedOrder(approvedOrder, requestData, priceBook) {
      return approvedOrder is map
        && approvedOrder.keys().size() == 4
        && approvedOrder.approvedAt == request.time
        && approvedOrder.priceBookRevision == priceBook.revision
        && validApprovedItems(
          approvedOrder.items,
          requestData.items,
          priceBook.prices
        )
        && approvedOrder.totalCents is int
        && approvedOrder.totalCents
          == approvedItemsTotalCents(approvedOrder.items);
    }

    function validApproval(requestId) {
      let before = resource.data;
      let after = request.resource.data;
      let priceBook = get(priceBookPath()).data;
      return before.status == "pending"
        && before.items is list
        && after.diff(before).affectedKeys().hasOnly([
          "status",
          "orderId",
          "reviewedAt",
          "reviewedBy",
          "approvedOrder",
          "orderStatus"
        ])
        && after.keys().size() == 15
        && after.status == "approved"
        && after.orderId == requestId
        && after.reviewedAt == request.time
        && after.reviewedBy == request.auth.uid
        && after.orderStatus == "Pending"
        && migrationIsReady()
        && validPriceBook(priceBook)
        && validApprovedOrder(after.approvedOrder, before, priceBook);
    }

    match /users/{userId} {
      allow get: if signedIn()
        && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /menuItems/{menuItemId} {
      allow read: if true;
      allow write: if false;
    }

    match /menuControl/{controlId} {
      allow get: if isAdmin();
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /orderRequests/{requestId} {
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.customerId == request.auth.uid);
      allow create: if signedIn()
        && validRequestCreate(request.resource.data);
      allow update: if isAdmin()
        && validApproval(requestId);
      allow delete: if false;
    }

    match /orders/{orderId} {
      allow read, write: if false;
    }
  }
}
