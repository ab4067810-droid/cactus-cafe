rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function validPublicReview(data) {
      return data.keys().size() == 4
        && data.keys().hasAll([
          "rating",
          "comment",
          "createdAt",
          "displayName"
        ])
        && data.rating is number
        && data.rating >= 1
        && data.rating <= 5
        && data.comment is string
        && data.comment.size() > 0
        && data.comment.size() <= 500
        && data.createdAt is timestamp
        && data.displayName == "Cactus Café Customer";
    }

    function menuPath(menuItemId) {
      return /databases/$(database)/documents/menuItems/$(menuItemId);
    }

    function catalogPath() {
      return /databases/$(database)/documents/menuPricingCatalog/current;
    }

    function requestPath(requestId) {
      return /databases/$(database)/documents/orderRequests/$(requestId);
    }

    function orderPath(orderId) {
      return /databases/$(database)/documents/orders/$(orderId);
    }

    function validText(value, maxLength) {
      return value is string
        && value.size() > 0
        && value.size() <= maxLength;
    }

    function validMenuEntry(entry) {
      return entry is map
        && entry.keys().size() == 3
        && entry.keys().hasAll(["name", "price", "available"])
        && validText(entry.name, 200)
        && entry.price is number
        && entry.price >= 0
        && entry.price <= 1000000
        && entry.available is bool;
    }

    function catalogEntryMatches(menuItemId, menuItem) {
      let catalog = getAfter(catalogPath()).data;
      return catalog.keys().hasAll([
          "items",
          "lastUpdatedMenuItemId",
          "lastUpdatedAt"
        ])
        && catalog.items is map
        && catalog.lastUpdatedMenuItemId == menuItemId
        && catalog.lastUpdatedAt == request.time
        && menuItemId in catalog.items
        && validMenuEntry(catalog.items[menuItemId])
        && catalog.items[menuItemId].name == menuItem.name
        && catalog.items[menuItemId].price == menuItem.price
        && catalog.items[menuItemId].available == menuItem.available;
    }

    function validRequestItem(item) {
      return item is map
        && item.keys().size() == 2
        && item.keys().hasAll(["id", "quantity"])
        && item.id is string
        && item.id.size() > 0
        && item.id.size() <= 1500
        && !item.id.matches(".*[/].*")
        && item.quantity is int
        && item.quantity >= 1
        && item.quantity <= 99;
    }

    function validRequestItems(items) {
      return items is list
        && items.size() >= 1
        && items.size() <= 10
        && validRequestItem(items[0])
        && (items.size() <= 1 || validRequestItem(items[1]))
        && (items.size() <= 2 || validRequestItem(items[2]))
        && (items.size() <= 3 || validRequestItem(items[3]))
        && (items.size() <= 4 || validRequestItem(items[4]))
        && (items.size() <= 5 || validRequestItem(items[5]))
        && (items.size() <= 6 || validRequestItem(items[6]))
        && (items.size() <= 7 || validRequestItem(items[7]))
        && (items.size() <= 8 || validRequestItem(items[8]))
        && (items.size() <= 9 || validRequestItem(items[9]));
    }

    function validRequest(data) {
      return data.customerId == request.auth.uid
        && data.keys().size() == 10
        && data.keys().hasAll([
          "customerId",
          "customerEmail",
          "customerName",
          "phone",
          "items",
          "orderType",
          "address",
          "notes",
          "status",
          "createdAt"
        ])
        && data.customerEmail is string
        && data.customerEmail.size() <= 254
        && (data.customerEmail == "" || data.customerEmail == request.auth.token.email)
        && validText(data.customerName, 120)
        && validText(data.phone, 40)
        && validRequestItems(data.items)
        && data.orderType in ["takeout", "delivery", "dine-in"]
        && data.address is string
        && data.address.size() <= 500
        && (data.orderType != "delivery" || data.address.size() > 0)
        && (data.orderType == "delivery" || data.address == "")
        && data.notes is string
        && data.notes.size() <= 1000
        && data.status == "pending"
        && data.createdAt == request.time;
    }

    function validOrderLine(orderItems, requestedItems, catalogItems, index) {
      let requestedItem = requestedItems[index];
      let orderItem = orderItems[index];
      return validRequestItem(requestedItem)
        && requestedItem.id in catalogItems
        && validMenuEntry(catalogItems[requestedItem.id])
        && catalogItems[requestedItem.id].available == true
        && orderItem is map
        && orderItem.keys().size() == 5
        && orderItem.keys().hasAll([
          "id",
          "name",
          "price",
          "quantity",
          "subtotal"
        ])
        && orderItem.id == requestedItem.id
        && orderItem.name == catalogItems[requestedItem.id].name
        && orderItem.price == catalogItems[requestedItem.id].price
        && orderItem.quantity is int
        && orderItem.quantity == requestedItem.quantity
        && orderItem.subtotal is number
        && math.abs(
          orderItem.subtotal
          - catalogItems[requestedItem.id].price * requestedItem.quantity
        ) <= 0.000001;
    }

    function validOrderLines(orderItems, requestedItems, catalogItems) {
      let itemCount = requestedItems.size();
      return orderItems is list
        && orderItems.size() == itemCount
        && validRequestItems(requestedItems)
        && catalogItems is map
        && validOrderLine(orderItems, requestedItems, catalogItems, 0)
        && (itemCount <= 1
          || validOrderLine(orderItems, requestedItems, catalogItems, 1))
        && (itemCount <= 2
          || validOrderLine(orderItems, requestedItems, catalogItems, 2))
        && (itemCount <= 3
          || validOrderLine(orderItems, requestedItems, catalogItems, 3))
        && (itemCount <= 4
          || validOrderLine(orderItems, requestedItems, catalogItems, 4))
        && (itemCount <= 5
          || validOrderLine(orderItems, requestedItems, catalogItems, 5))
        && (itemCount <= 6
          || validOrderLine(orderItems, requestedItems, catalogItems, 6))
        && (itemCount <= 7
          || validOrderLine(orderItems, requestedItems, catalogItems, 7))
        && (itemCount <= 8
          || validOrderLine(orderItems, requestedItems, catalogItems, 8))
        && (itemCount <= 9
          || validOrderLine(orderItems, requestedItems, catalogItems, 9));
    }

    function orderTotalMatches(orderItems, total) {
      let itemCount = orderItems.size();
      return total is number
        && total >= 0
        && math.abs(total - (
          orderItems[0].subtotal
          + (itemCount > 1 ? orderItems[1].subtotal : 0)
          + (itemCount > 2 ? orderItems[2].subtotal : 0)
          + (itemCount > 3 ? orderItems[3].subtotal : 0)
          + (itemCount > 4 ? orderItems[4].subtotal : 0)
          + (itemCount > 5 ? orderItems[5].subtotal : 0)
          + (itemCount > 6 ? orderItems[6].subtotal : 0)
          + (itemCount > 7 ? orderItems[7].subtotal : 0)
          + (itemCount > 8 ? orderItems[8].subtotal : 0)
          + (itemCount > 9 ? orderItems[9].subtotal : 0)
        )) <= 0.000001;
    }

    function orderMatchesRequest(order, requestId, orderRequest) {
      return order is map
        && order.keys().size() == 12
        && order.keys().hasAll([
          "requestId",
          "customerId",
          "customerEmail",
          "customerName",
          "phone",
          "orderType",
          "address",
          "notes",
          "items",
          "total",
          "status",
          "createdAt"
        ])
        && order.requestId == requestId
        && order.customerId == orderRequest.customerId
        && order.customerEmail == orderRequest.customerEmail
        && order.customerName == orderRequest.customerName
        && order.phone == orderRequest.phone
        && order.orderType == orderRequest.orderType
        && order.address == orderRequest.address
        && order.notes == orderRequest.notes
        && order.status == "Pending"
        && order.createdAt == request.time
        && validOrderLines(
          order.items,
          orderRequest.items,
          get(catalogPath()).data.items
        )
        && orderTotalMatches(order.items, order.total);
    }

    function validApprovalPair(requestId, order, beforeRequest, afterRequest) {
      return beforeRequest.status == "pending"
        && afterRequest.keys().size() == 14
        && afterRequest.keys().hasAll([
          "customerId",
          "customerEmail",
          "customerName",
          "phone",
          "items",
          "orderType",
          "address",
          "notes",
          "status",
          "createdAt",
          "orderId",
          "reviewedAt",
          "reviewedBy"
        ])
        && afterRequest.diff(beforeRequest).affectedKeys().hasOnly([
          "status",
          "orderId",
          "reviewedAt",
          "reviewedBy"
        ])
        && afterRequest.status == "approved"
        && afterRequest.orderId == requestId
        && afterRequest.reviewedAt == request.time
        && afterRequest.reviewedBy == request.auth.uid
        && orderMatchesRequest(order, requestId, afterRequest);
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.role == "customer";
      allow update: if isAdmin()
        || (isOwner(userId)
          && resource.data.role == "customer"
          && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    match /menuItems/{menuItemId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && validMenuEntry({
          "name": request.resource.data.name,
          "price": request.resource.data.price,
          "available": request.resource.data.available
        })
        && catalogEntryMatches(menuItemId, request.resource.data);
      allow delete: if isAdmin()
        && getAfter(catalogPath()).data.lastUpdatedMenuItemId == menuItemId
        && getAfter(catalogPath()).data.lastUpdatedAt == request.time
        && !(menuItemId in getAfter(catalogPath()).data.items)
        && !existsAfter(menuPath(menuItemId));
    }

    match /menuPricingCatalog/{catalogId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin()
        && catalogId == "current"
        && request.resource.data.keys().size() == 3
        && request.resource.data.keys().hasAll([
          "items",
          "lastUpdatedMenuItemId",
          "lastUpdatedAt"
        ])
        && request.resource.data.items is map
        && request.resource.data.items.keys().size() == 1
        && request.resource.data.lastUpdatedMenuItemId is string
        && request.resource.data.items.keys().hasAll([
          request.resource.data.lastUpdatedMenuItemId
        ])
        && request.resource.data.lastUpdatedAt == request.time
        && existsAfter(menuPath(request.resource.data.lastUpdatedMenuItemId))
        && validMenuEntry(
          request.resource.data.items[
            request.resource.data.lastUpdatedMenuItemId
          ]
        )
        && getAfter(
          menuPath(request.resource.data.lastUpdatedMenuItemId)
        ).data.name == request.resource.data.items[
          request.resource.data.lastUpdatedMenuItemId
        ].name
        && getAfter(
          menuPath(request.resource.data.lastUpdatedMenuItemId)
        ).data.price == request.resource.data.items[
          request.resource.data.lastUpdatedMenuItemId
        ].price
        && getAfter(
          menuPath(request.resource.data.lastUpdatedMenuItemId)
        ).data.available == request.resource.data.items[
          request.resource.data.lastUpdatedMenuItemId
        ].available;
      allow update: if isAdmin()
        && catalogId == "current"
        && request.resource.data.keys().size() == 3
        && request.resource.data.keys().hasAll([
          "items",
          "lastUpdatedMenuItemId",
          "lastUpdatedAt"
        ])
        && request.resource.data.items is map
        && request.resource.data.lastUpdatedMenuItemId is string
        && request.resource.data.lastUpdatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            "items",
            "lastUpdatedMenuItemId",
            "lastUpdatedAt"
          ])
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasAll(["lastUpdatedAt"])
        && request.resource.data.items.diff(resource.data.items).affectedKeys()
          .hasOnly([request.resource.data.lastUpdatedMenuItemId])
        && (
          (
            existsAfter(menuPath(
              request.resource.data.lastUpdatedMenuItemId
            ))
            && request.resource.data.lastUpdatedMenuItemId
              in request.resource.data.items
            && validMenuEntry(request.resource.data.items[
              request.resource.data.lastUpdatedMenuItemId
            ])
            && getAfter(menuPath(
              request.resource.data.lastUpdatedMenuItemId
            )).data.name == request.resource.data.items[
              request.resource.data.lastUpdatedMenuItemId
            ].name
            && getAfter(menuPath(
              request.resource.data.lastUpdatedMenuItemId
            )).data.price == request.resource.data.items[
              request.resource.data.lastUpdatedMenuItemId
            ].price
            && getAfter(menuPath(
              request.resource.data.lastUpdatedMenuItemId
            )).data.available == request.resource.data.items[
              request.resource.data.lastUpdatedMenuItemId
            ].available
          )
          || (
            !existsAfter(menuPath(
              request.resource.data.lastUpdatedMenuItemId
            ))
            && !(request.resource.data.lastUpdatedMenuItemId
              in request.resource.data.items)
          )
        );
      allow delete: if false;
    }

    match /orderRequests/{requestId} {
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.customerId == request.auth.uid);
      allow create: if signedIn() && validRequest(request.resource.data);
      allow update: if isAdmin()
        && (
          validApprovalPair(
            requestId,
            getAfter(orderPath(requestId)).data,
            resource.data,
            request.resource.data
          )
          || (
            resource.data.status == "pending"
            && request.resource.data.status == "rejected"
            && request.resource.data.keys().size() == 13
            && request.resource.data.keys().hasAll([
              "customerId",
              "customerEmail",
              "customerName",
              "phone",
              "items",
              "orderType",
              "address",
              "notes",
              "status",
              "createdAt",
              "reviewedAt",
              "reviewedBy",
              "rejectionReason"
            ])
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                "status",
                "reviewedAt",
                "reviewedBy",
                "rejectionReason"
              ])
            && request.resource.data.reviewedAt == request.time
            && request.resource.data.reviewedBy == request.auth.uid
            && validText(request.resource.data.rejectionReason, 500)
          )
          || (
            resource.data.status == "approved"
            && request.resource.data.status == "approved"
            && resource.data.orderStatus in [
              "Pending",
              "Confirmed",
              "Preparing",
              "Ready",
              "Ready for Pickup",
              "Out for Delivery",
              "Completed",
              "Cancelled"
            ]
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["orderStatus"])
            && request.resource.data.orderStatus in [
              "Pending",
              "Confirmed",
              "Preparing",
              "Ready",
              "Ready for Pickup",
              "Out for Delivery",
              "Completed",
              "Cancelled"
            ]
          )
        );
      allow delete: if false;
    }

    match /orders/{orderId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.customerId == request.auth.uid);
      allow create: if isAdmin()
        && exists(requestPath(orderId))
        && validApprovalPair(
          orderId,
          request.resource.data,
          get(requestPath(orderId)).data,
          getAfter(requestPath(orderId)).data
        );
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
        && request.resource.data.status in [
          "Pending",
          "Confirmed",
          "Preparing",
          "Ready",
          "Ready for Pickup",
          "Out for Delivery",
          "Completed",
          "Cancelled"
        ];
      allow delete: if false;
    }

    match /reservations/{reservationId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "Pending";
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
        && request.resource.data.status in [
          "Pending",
          "Confirmed",
          "Completed",
          "Cancelled"
        ];
      allow delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.customerId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == "Pending"
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() > 0
        && request.resource.data.comment.size() <= 500;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
        && request.resource.data.status in ["Pending", "Approved", "Rejected"];
      allow delete: if isAdmin();
    }

    match /publicReviews/{reviewId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && validPublicReview(request.resource.data);
      allow delete: if isAdmin();
    }
  }
}
